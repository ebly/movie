# 复制为 deploy/.env 后填写。.env 已被 .gitignore 排除，不要提交。
# 用法：docker compose --env-file deploy/.env up -d --build

# ---- 域名 ----
# 前台域名：DNS A 记录指向服务器 IP，可以套 Cloudflare 橙云
DOMAIN=yingtu.example.com
# PanSou 域名：只给 app 容器内部用。DNS 也要解析到本机，但【不要】套橙云，
# 否则 Caddy 看到的 remote_ip 会变成 Cloudflare 的 IP，内网白名单失效。
PANSOU_DOMAIN=pansou.example.com
# Let's Encrypt 通知邮箱
ACME_EMAIL=you@example.com

# ---- 前台访问门槛 ----
BASIC_AUTH_USER=family
# 生成：docker run --rm caddy:2-alpine caddy hash-password --plaintext '你的密码'
# 注意 hash 里的每个 $ 都要写成 $$，否则 docker compose 会当成变量替换
# 例：$2a$14$abc  →  $$2a$$14$$abc
BASIC_AUTH_HASH=$$2a$$14$$请替换成真实的bcrypt hash

# ---- PanSou ----
PANSOU_USER=yingtu
# 不要含逗号（AUTH_USERS 用冒号分隔用户、逗号分隔用户组）
PANSOU_PASS=请替换成强密码
PANSOU_JWT_SECRET=请替换成32位以上随机串

# ---- 插件白名单：只留网盘/影视资源站，排除 BT/磁力/社交抓取 ----
ENABLED_PLUGINS=diduan,jutoushe,labi,libvio,lou1,susu,wanou,zhizhen,488run,aipan,clxiong,djgou,duoduo,dyyj,dyyjpro,erxiaopan,haitunsou,hdmoli,huban,jsnoteclub,lingjisp,meitizy,miosou,muou,nsgame,ouge,quarkres,quarktv,shandian,ting77,woniu,xiaokupan,yunsou,5266ys,buerchen,cldi,clmao,cyg,duanjuw,dy4k,dygang,feikuai,gaoqing888,gying,hjzhencai,hunhepan,ikantv,kkv,kpkuang,leso,melost,pan365,panlian,pansearch,qiwei,quark4k,quarksoo,sopanya,sousou,xdpan,xiaoyu,xiaozhang,yingso,yulinshufa,yunso,zlxapp,zxzj,u3c3
