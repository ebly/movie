/* ============================================================
   映途小程序 · 全局样式
   与网页端同一套暖色纸张主题：象牙底、陶土色强调、衬线标题。
   ============================================================ */

page {
  --canvas: #f7f3ee;
  --canvas-deep: #f0e8df;
  --surface: #fffaf5;
  --surface-soft: #f3eae1;
  --text: #2f3230;
  --text-soft: #5f6662;
  --muted: #8d9490;
  --line: rgba(78, 73, 68, 0.12);
  --line-strong: rgba(78, 73, 68, 0.24);
  --accent: #a4684f;
  --accent-soft: rgba(164, 104, 79, 0.1);
  --sage: #66776a;
  --success: #4e7b62;
  --warning: #b57a4f;

  background: var(--canvas);
  color: var(--text);
  font-family: "PingFang SC", "Noto Sans SC", "Helvetica Neue", Arial, sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

.serif {
  font-family: Georgia, "Songti SC", "Noto Serif SC", "Times New Roman", serif;
}

.page {
  padding: 0 32rpx 48rpx;
  box-sizing: border-box;
}

/* ---------- 顶栏 ---------- */

.hero {
  padding: 40rpx 0 24rpx;
}

.hero-kicker {
  display: block;
  font-size: 22rpx;
  letter-spacing: 6rpx;
  text-transform: uppercase;
  color: var(--muted);
}

.hero-title {
  display: block;
  margin-top: 12rpx;
  font-size: 68rpx;
  line-height: 1.15;
  letter-spacing: 2rpx;
  color: var(--text);
}

.hero-sub {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--text-soft);
}

/* ---------- 卡片 ---------- */

.card {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  box-shadow: 0 12rpx 30rpx rgba(66, 55, 44, 0.07);
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 36rpx 0 20rpx;
}

.section-title {
  font-size: 34rpx;
  letter-spacing: 1rpx;
}

.section-note {
  font-size: 22rpx;
  color: var(--muted);
}

/* ---------- 胶囊按钮 ---------- */

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--line-strong);
  color: var(--text-soft);
  font-size: 26rpx;
  background: transparent;
  line-height: 1.4;
}

.chip.is-on {
  background: var(--text);
  border-color: var(--text);
  color: #fdf8f2;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 22rpx 32rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  border: 1rpx solid var(--line-strong);
  color: var(--text);
  background: var(--surface);
}

.btn.is-solid {
  background: var(--accent);
  border-color: var(--accent);
  color: #fff8f2;
}

.btn.is-ghost {
  background: transparent;
}

/* ---------- 海报 ---------- */

.poster {
  position: relative;
  width: 100%;
  border-radius: 20rpx;
  overflow: hidden;
  background: var(--surface-soft);
}

.poster-fallback {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: rgba(253, 248, 242, 0.94);
}

.poster-fallback-text {
  font-size: 40rpx;
  letter-spacing: 2rpx;
}

.poster-fallback-year {
  font-size: 22rpx;
  opacity: 0.8;
}

.poster-img {
  position: relative;
  width: 100%;
  height: 100%;
  display: block;
}

.rating {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(24, 20, 16, 0.72);
  color: #f6e7cf;
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

/* ---------- 文字 ---------- */

.h1 {
  font-size: 44rpx;
  line-height: 1.3;
}

.h2 {
  font-size: 34rpx;
  line-height: 1.35;
}

.muted {
  color: var(--muted);
  font-size: 24rpx;
}

.soft {
  color: var(--text-soft);
}

.clip-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.clip-3 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

/* ---------- 状态 ---------- */

.state {
  padding: 80rpx 24rpx;
  text-align: center;
  color: var(--muted);
  font-size: 26rpx;
}

.state-action {
  margin-top: 28rpx;
  display: flex;
  justify-content: center;
}

.loader {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  padding: 48rpx 0;
}

.loader-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--accent);
  opacity: 0.35;
  animation: pulse 1.1s infinite ease-in-out;
}

.loader-dot:nth-child(2) { animation-delay: 0.15s; }
.loader-dot:nth-child(3) { animation-delay: 0.3s; }

@keyframes pulse {
  0%, 100% { opacity: 0.2; transform: translateY(0); }
  50% { opacity: 0.9; transform: translateY(-6rpx); }
}

/* ---------- 搜索框（搜索页与网盘页共用） ---------- */

.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 10rpx 10rpx 10rpx 28rpx;
  border-radius: 999rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  box-shadow: 0 10rpx 24rpx rgba(66, 55, 44, 0.06);
}

.search-input {
  flex: 1;
  height: 72rpx;
  font-size: 28rpx;
  color: var(--text);
}

.search-placeholder {
  color: var(--muted);
}

.search-clear {
  width: 52rpx;
  height: 52rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  color: var(--muted);
  font-size: 34rpx;
  background: var(--surface-soft);
}

.search-submit {
  padding: 14rpx 30rpx;
  border-radius: 999rpx;
  background: var(--accent);
  color: #fff8f2;
  font-size: 26rpx;
}

/* ---------- 去网盘搜的引导条 ---------- */

.pan-cta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 26rpx 28rpx;
  border-radius: 20rpx;
  border: 1rpx dashed var(--line-strong);
  font-size: 27rpx;
  color: var(--text-soft);
}

.pan-cta.is-primary {
  border-style: solid;
  border-color: var(--accent);
  background: var(--accent-soft);
  color: var(--accent);
}

.pan-cta-go {
  color: var(--accent);
}

.divider {
  height: 1rpx;
  background: var(--line);
  margin: 32rpx 0;
}

.footer-note {
  margin-top: 48rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  background: var(--surface-soft);
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.7;
}
