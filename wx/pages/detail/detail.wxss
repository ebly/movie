.detail-hero {
  position: relative;
  padding: 96rpx 40rpx 48rpx;
  overflow: hidden;
}

.hero-veil {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(20, 16, 12, 0.05) 0%, rgba(20, 16, 12, 0.45) 100%);
}

.detail-hero-body {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.detail-type {
  align-self: flex-start;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 250, 245, 0.22);
  color: #fff8f2;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.detail-name {
  margin-top: 8rpx;
  font-size: 72rpx;
  line-height: 1.15;
  color: #fffaf5;
  text-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.28);
}

.detail-original {
  font-size: 26rpx;
  color: rgba(255, 250, 245, 0.82);
}

.detail-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.hero-badge {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(20, 16, 12, 0.32);
  color: #fff6e9;
  font-size: 22rpx;
}

.detail-body {
  padding: 36rpx 32rpx 56rpx;
}

.genre {
  display: block;
  font-size: 24rpx;
  color: var(--accent);
  letter-spacing: 1rpx;
}

.synopsis {
  display: block;
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.75;
  color: var(--text-soft);
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 20rpx;
}

.tag {
  font-size: 22rpx;
  color: var(--muted);
}

.offer {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx;
  margin-bottom: 16rpx;
  border-radius: 20rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
}

.offer-hover {
  background: var(--surface-soft);
}

.offer-logo {
  flex: 0 0 64rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
  font-weight: 500;
}

.offer-main {
  flex: 1;
  min-width: 0;
}

.offer-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.offer-name {
  font-size: 28rpx;
}

.offer-verified {
  padding: 0 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: var(--success);
  background: rgba(78, 123, 98, 0.12);
}

.offer-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.offer-price {
  display: block;
  margin-top: 2rpx;
  font-size: 22rpx;
  color: var(--text-soft);
}

.offer-copy {
  flex: 0 0 auto;
  font-size: 22rpx;
  color: var(--accent);
}

.related {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.related-item {
  width: 200rpx;
  margin-bottom: 28rpx;
}

.related-poster {
  height: 290rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.related-initial {
  color: rgba(253, 248, 242, 0.95);
  font-size: 56rpx;
}

.related-title {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.4;
}
