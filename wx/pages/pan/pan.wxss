.types {
  margin: 24rpx 0 8rpx;
}

.result-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 28rpx 0 16rpx;
}

.reload {
  font-size: 23rpx;
  color: var(--accent);
}

.pan-card {
  padding: 24rpx 26rpx;
  margin-bottom: 18rpx;
  border-radius: 20rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  box-shadow: 0 10rpx 24rpx rgba(66, 55, 44, 0.05);
}

.pan-card-hover {
  background: var(--surface-soft);
}

.pan-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pan-type {
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: var(--accent-soft);
  color: var(--accent);
  font-size: 20rpx;
}

.pan-time {
  font-size: 20rpx;
  color: var(--muted);
}

.pan-title {
  display: block;
  margin-top: 12rpx;
  font-size: 30rpx;
  line-height: 1.45;
}

.pan-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}

.pan-code {
  font-size: 22rpx;
  color: var(--warning);
}

.pan-nocode {
  font-size: 22rpx;
  color: var(--muted);
}

.pan-copy {
  font-size: 22rpx;
  color: var(--accent);
}

.pan-source {
  display: block;
  margin-top: 10rpx;
  font-size: 20rpx;
  color: rgba(141, 148, 144, 0.85);
}

.load-hint {
  padding: 28rpx 0 12rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--muted);
}
