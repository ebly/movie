{
  "name": "yingtu",
  "version": "1.0.0",
  "private": true,
  "description": "映途：正版影视观看渠道搜索的全栈演示（Cloudflare Workers + D1 生产后端，Node 本地开发/测试服务，无依赖客户端）。品牌文案见 config/brand.json",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "pansou:start": "node scripts/start-pansou.mjs",
    "pansou:check": "node scripts/start-pansou.mjs --check",
    "test:pansou": "node --test test/pansou.test.js",
    "test:quark-ui": "node scripts/quark-ui-smoke.mjs",
    "test": "node --test",
    "dev:worker": "wrangler dev",
    "db:migrate": "wrangler d1 migrations apply yingtu-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply yingtu-db --remote",
    "pinyin:build": "node scripts/build-pinyin.mjs",
    "deploy": "node scripts/sync-catalog.mjs && wrangler deploy",
    "deploy:seo": "npm run deploy && npm run seo:ping",
    "seo:init-key": "node scripts/ping-search-engines.mjs --init-key",
    "seo:check": "node scripts/ping-search-engines.mjs --check",
    "seo:ping": "node scripts/ping-search-engines.mjs",
    "preflight": "node scripts/preflight.mjs",
    "smoke:worker": "node --experimental-sqlite --no-warnings scripts/worker-smoke.mjs",
    "admin:local": "node admin-local/server.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.53.0"
  },
  "engines": {
    "node": ">=18.16"
  },
  "license": "MIT"
}
